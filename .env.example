# development | production. Production hides /api/docs and refuses to start with a
# weak JWT secret or an admin password shorter than 12 characters.
APP_ENV=development

# MongoDB. Under docker compose the host is the mongo SERVICE name.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=sparsh-medical

# JWT issued to the admin after login. Production: a random 32+ character value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# The single admin account for the dashboard (/admin/login). Customers don't
# sign in: they browse and order on WhatsApp as guests. Changing either value
# signs out every admin session. Production requires a 12+ character password, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Browser origins allowed to call the API (comma-separated).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080

# Product images are resized (max 1200px) and stored as WebP.
# Cloudinary (recommended on Render/any host with a wiped disk): set all three
# from the Cloudinary dashboard and images are stored there. Leave them empty
# to store images on local disk under MEDIA_DIR instead.
# Either the single URL from the dashboard (API Keys page):
CLOUDINARY_URL=
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...or the three parts separately (these override CLOUDINARY_URL):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=sparsh-medical/products

# Local-disk images (when Cloudinary is not set): served at /media. Use a
# persistent volume in production (docker compose mounts one at /app/media).
MEDIA_DIR=media
MAX_IMAGE_SIZE_MB=5

# Public base URL of this API, prefixed to image URLs. Empty = relative /media/...
# (fine when the frontend serves /media from the same origin).
PUBLIC_BASE_URL=
