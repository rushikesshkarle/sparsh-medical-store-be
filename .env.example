# development | production. Production hides /api/docs and refuses to start with a
# weak JWT secret or without Google OAuth configured.
APP_ENV=development

# MongoDB. Under docker compose the host is the mongo SERVICE name.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=sparsh-medical

# JWT this API issues after a Google sign-in. Production: a random 32+ character value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Google OAuth client (Google Cloud Console → Credentials → OAuth client ID,
# type "Web application"). Authorized JavaScript origins = the frontend URL(s).
# No redirect URI needed (popup flow). GOOGLE_CLIENT_ID must equal the frontend's
# VITE_GOOGLE_CLIENT_ID. The secret stays on the backend only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails that get the admin dashboard (comma-separated, case-insensitive).
# Every other Google account signs in as a normal customer. Empty = no admins.
ALLOWED_ADMIN_EMAILS=owner@example.com

# Browser origins allowed to call the API (comma-separated).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080

# Product images: stored under MEDIA_DIR, served at /media. Use a persistent
# volume in production (docker compose mounts one at /app/media).
MEDIA_DIR=media
MAX_IMAGE_SIZE_MB=5

# Public base URL of this API, prefixed to image URLs. Empty = relative /media/...
# (fine when the frontend serves /media from the same origin).
PUBLIC_BASE_URL=
